#!/usr/bin/env bash
# lab-windows — lista las ventanas de una sesión, una por línea.
#
# Uso: lab-windows SESION
# Imprime: índice nombre paneles activa(1/0). Sale con 1 si la sesión no existe.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

(( $# == 1 )) || { echo "uso: lab-windows SESION" >&2; exit 2; }
session="$1"

# Con = el nombre es exacto: -t api no encuentra api-vieja.
tmx has-session -t "=$session" 2>/dev/null || { echo "no existe la sesión: $session" >&2; exit 1; }

# TODO 4: list-windows de la sesión con un format propio. Borra el echo.
#         Pista: tmx list-windows -t "=$session" -F '#{window_index} #{window_name} #{window_panes} #{window_active}'
#         Prueba: TMUX_SOCKET=lab ./starter/bin/lab-windows api
echo "sin implementar" >&2
exit 1
