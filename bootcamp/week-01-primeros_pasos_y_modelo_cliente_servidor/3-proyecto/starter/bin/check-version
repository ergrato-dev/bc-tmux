#!/usr/bin/env bash
# check-version — comprueba que el tmux instalado cumple la versión mínima.
#
# Uso: check-version [MINIMA]        (por defecto 3.4)
#      TMUX_BIN=/otra/ruta/tmux check-version
#
# Códigos de salida: 0 cumple, 1 es más vieja, 2 tmux no está o no se entiende.
set -euo pipefail

min="${1:-3.4}"
bin="${TMUX_BIN:-tmux}"

# TODO 1: guarda la salida de "$bin" -V en "salida" dentro de un if, con
#         2>/dev/null. Si falla: mensaje por stderr (>&2) y exit 2.
#           if ! salida=$(...); then ...; fi

# TODO 2: quita "tmux " y luego "next-" del principio (${var#prefijo}) y
#         extrae mayor y menor con [[ "$version" =~ ^([0-9]+)\.([0-9]+) ]]
#         (sin $ al final: la letra de 3.5a sobra). Están en BASH_REMATCH[1]
#         y BASH_REMATCH[2]. Si no casa: mensaje por stderr y exit 2.

# TODO 3: separa "$min" igual, pero con $ al final: la mínima es
#         exactamente MAYOR.MENOR. Si no casa: mensaje por stderr y exit 2.

# TODO 4: compara como números con (( )), no como texto: 3.10 > 3.9.
#         Cumple si mayor > min_mayor, o si son iguales y menor >= min_menor.
#         Si cumple: imprime "<salida> >= <min>: ok" (sale con 0).
#         Si no: "<salida> < <min>: actualiza tmux (docs/setup-entorno.md)"
#         por stderr y exit 1. Borra las dos líneas de abajo.

echo "check-version: sin implementar (min=$min, bin=$bin)" >&2
exit 99
