#!/usr/bin/env bash
# check-version — comprueba que el tmux instalado cumple la versión mínima.
#
# Uso: check-version [MINIMA]        (por defecto 3.4)
#      TMUX_BIN=/otra/ruta/tmux check-version
#
# Códigos de salida: 0 cumple, 1 es más vieja, 2 tmux no está o no se entiende.
set -euo pipefail

min="${1:-3.4}"
bin="${TMUX_BIN:-tmux}"

# TODO 1: guarda la salida de "$bin" -V en "output" dentro de un if, con
#         2>/dev/null. Si falla: mensaje por stderr (>&2) y exit 2.
#           if ! output=$(...); then ...; fi

# TODO 2: quita "tmux " y luego "next-" del principio (${var#prefijo}) y
#         extrae mayor y menor con [[ "$version" =~ ^([0-9]+)\.([0-9]+) ]]
#         (sin $ al final: la letra de 3.5a sobra). Guárdalos en major y
#         minor desde BASH_REMATCH[1] y BASH_REMATCH[2]. Si no casa: mensaje
#         por stderr y exit 2.

# TODO 3: separa "$min" igual en min_major y min_minor, pero con $ al final:
#         la mínima es exactamente MAYOR.MENOR. Si no casa: mensaje por
#         stderr y exit 2.

# TODO 4: compara como números con (( )), no como texto: 3.10 > 3.9.
#         Cumple si major > min_major, o si son iguales y minor >= min_minor.
#         Si cumple: imprime "$output >= $min: ok" (sale con 0).
#         Si no: "$output < $min: actualiza tmux (docs/setup-entorno.md)"
#         por stderr y exit 1. Borra las dos líneas de abajo.

echo "check-version: sin implementar (min=$min, bin=$bin)" >&2
exit 99
