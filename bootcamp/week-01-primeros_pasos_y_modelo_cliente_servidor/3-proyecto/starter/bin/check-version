#!/usr/bin/env bash
# check-version — comprueba que el tmux instalado cumple la versión mínima.
#
# Uso: check-version [MINIMA]        (por defecto 3.4)
#      TMUX_BIN=/otra/ruta/tmux check-version
#
# Códigos de salida: 0 cumple, 1 es más vieja, 2 tmux no está o no se entiende.
set -euo pipefail

min="${1:-3.4}"
bin="${TMUX_BIN:-tmux}"

# TODO 1: ejecuta "$bin" -V y guarda su salida. Si falla, avisa y sal con 2.

# TODO 2: quita "tmux " y "next-" del principio y extrae MAYOR y MENOR con
#         [[ =~ ]] y BASH_REMATCH. La letra de parche (3.5a) no cuenta.

# TODO 3: separa "$min" en mayor y menor de la misma forma.

# TODO 4: compara como números (( )), no como texto: 3.10 > 3.9.
#         Si cumple: imprime "<salida> >= <min>: ok" y sal con 0.
#         Si no: imprime "<salida> < <min>: actualiza tmux" y sal con 1.

echo "check-version: sin implementar (min=$min, bin=$bin)" >&2
exit 99
