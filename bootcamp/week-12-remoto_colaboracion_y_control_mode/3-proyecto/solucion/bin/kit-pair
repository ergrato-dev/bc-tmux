#!/usr/bin/env bash
# kit-pair — comparte una sesión de tmux con otro usuario de esta máquina.
#
# Uso: kit-pair start                 crea (o reutiliza) el socket compartido y la sesión pair
#      kit-pair allow USUARIO [-w]    deja entrar a USUARIO: solo lectura; con -w, también escribe
#      kit-pair deny USUARIO          le quita el acceso y desconecta sus clientes
#      kit-pair list                  quién entra: (R) solo lectura, (W) escritura
#      kit-pair stop                  cierra el servidor compartido y borra su directorio
# Salida: 0 bien, 1 sin sesión compartida, usuario inexistente o sin permisos, 2 uso incorrecto.
#
# Variables: KIT_PAIR_GROUP (grupo que comparte el socket, por defecto pair) y
# KIT_PAIR_DIR (directorio del socket, por defecto /tmp/kit-pair-USUARIO).
set -euo pipefail

group=${KIT_PAIR_GROUP:-pair}
dir=${KIT_PAIR_DIR:-${TMUX_TMPDIR:-/tmp}/kit-pair-$(id -un)}
sock=$dir/pair
kit=$(cd "$(dirname "$0")/.." && pwd)

# Aquí no vale -L "$TMUX_SOCKET": -L pone el socket en /tmp/tmux-UID, un
# directorio 0700 en el que nadie más puede entrar. El servidor compartido
# vive en su propio directorio y se le habla con -S; TMUX_BIN sí se respeta.
tmx() { "${TMUX_BIN:-tmux}" -S "$sock" "$@"; }

usage() { sed -n '4,8s/^# \{0,1\}//p' "$0" >&2; exit 2; }

die() { echo "kit-pair: $*" >&2; exit 1; }

need_server() {
  tmx has-session 2>/dev/null || die "no hay sesión compartida: ejecuta kit-pair start"
}

# El nombre acaba en argv de tmux: sin esto, "-d" o "-l" serían opciones de
# server-access. Mismo patrón que useradd, más mayúsculas y punto (macOS).
check_user() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9._-]{0,31}$ ]] || {
    echo "kit-pair: nombre de usuario no válido: $1" >&2
    exit 2
  }
}

has_access() { tmx server-access -l | awk -v u="$1" '$1 == u { f = 1 } END { exit !f }'; }

start() {
  # Los permisos van por grupo: el socket es 660 y solo entra quien esté en
  # él. Con 666 cualquier usuario de la máquina llegaría a server-access.
  [[ " $(id -Gn) " == *" $group "* ]] ||
    die "no perteneces al grupo $group: sudo groupadd $group; sudo usermod -aG $group $(id -un) (y vuelve a entrar), o usa KIT_PAIR_GROUP"

  mkdir -p "$dir"
  # En /tmp cualquiera puede crear el directorio antes que tú y esperar a
  # que dejes el socket dentro: si no es tuyo (o es un enlace), no se usa.
  [[ -O "$dir" && ! -L "$dir" ]] || die "$dir no es tuyo: usa otro KIT_PAIR_DIR"
  chgrp "$group" "$dir"
  # 710: el grupo atraviesa el directorio para llegar al socket, pero no lo lista.
  chmod 0710 "$dir"

  if ! tmx has-session -t "=pair" 2>/dev/null; then
    tmx -f "$kit/tmux.conf" new-session -d -s pair
  fi

  # tmux crea el socket 600 y le pone o quita la x según haya clientes; los
  # bits rw que pongas aquí los respeta. Relativo, para no borrar esa x.
  chgrp "$group" "$sock"
  chmod g+rw,o= "$sock"
  tmx set -g @kit-pair-socket "$sock"

  local q
  q=$(printf '%q' "$sock")
  echo "kit-pair: sesión pair en $sock"
  echo "  tú:       tmux -S $q attach -t pair"
  echo "  invitado: tmux -S $q attach -t pair   (después de kit-pair allow USUARIO)"
}

# server-access -a sin más da escritura: aquí, solo lectura salvo -w.
allow() {
  local user=$1 mode=$2
  check_user "$user"
  need_server
  id -u "$user" >/dev/null 2>&1 || die "no existe el usuario $user"
  if has_access "$user"; then
    tmx server-access "$mode" "$user"
  else
    tmx server-access -a "$mode" "$user"
  fi
  tmx server-access -l | awk -v u="$user" '$1 == u { print "kit-pair: " $0 }'
}

# server-access -d también desconecta los clientes que ese usuario tenga
# abiertos. Quitar a quien no estaba no es un error: el resultado es el mismo.
deny() {
  local user=$1
  check_user "$user"
  need_server
  if has_access "$user"; then
    tmx server-access -d "$user"
    echo "kit-pair: $user ya no tiene acceso"
  else
    echo "kit-pair: $user no tenía acceso"
  fi
}

list() {
  need_server
  tmx server-access -l
}

# tmux borra su socket al salir, pero kill-server vuelve antes de que el
# servidor termine: el rm evita que rmdir encuentre el directorio lleno.
# Si tú dejaste algo más dentro, el directorio se queda.
stop() {
  if tmx has-session 2>/dev/null; then
    tmx kill-server
    rm -f "$sock"
    echo "kit-pair: servidor compartido cerrado"
  else
    echo "kit-pair: no había sesión compartida"
  fi
  rmdir "$dir" 2>/dev/null || true
}

case ${1:-} in
  start | list | stop)
    (( $# == 1 )) || usage
    "$1"
    ;;
  allow)
    (( $# == 2 || $# == 3 )) || usage
    mode=-r
    if (( $# == 3 )); then
      [[ $3 == -w ]] || usage
      mode=-w
    fi
    allow "$2" "$mode"
    ;;
  deny)
    (( $# == 2 )) || usage
    deny "$2"
    ;;
  *) usage ;;
esac
