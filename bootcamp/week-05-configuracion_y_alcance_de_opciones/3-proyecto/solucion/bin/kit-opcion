#!/usr/bin/env bash
# kit-opcion — dice qué valor tiene una opción y de qué nivel sale.
#
# Uso: kit-opcion OPCION [TARGET]
# TARGET es un panel (api:1.2, %3); dentro de tmux, por defecto el actual.
# Imprime "VALOR (NIVEL)", con NIVEL: panel, ventana, sesión, global o servidor.
# Salida: 0 encontrada, 1 la opción o el target no existen, 2 uso incorrecto.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

uso() { sed -n '4,7s/^# \{0,1\}//p' "$0" >&2; exit 2; }

(( $# >= 1 && $# <= 2 )) || uso
opcion=$1
target=${2:-${TMUX_PANE:-}}
[[ -n "$target" ]] || { echo "kit-opcion: fuera de tmux, indica el TARGET" >&2; exit 2; }

# list-panes falla si el target no existe; display-message usaría otro panel.
if ! tmx list-panes -t "$target" >/dev/null 2>&1; then
  echo "kit-opcion: no existe el panel $target" >&2
  exit 1
fi

# valor FLAGS... — el valor de $opcion en la lista de ese nivel, o nada.
# Con el nombre de la opción, show elige el alcance por su cuenta y -p, -w o
# -s no cambian nada. Sin nombre, lista solo lo definido en ese nivel: por eso
# se pide la lista entera y se busca en ella.
valor() {
  tmx show "$@" 2>/dev/null | awk -v o="$opcion" '$1 == o { sub(/^[^ ]+ /, ""); print; f = 1; exit } END { exit !f }'
}

# Del nivel más concreto al más general: el primero que la define, gana.
# Las de servidor no se heredan: solo existen en un sitio.
if v=$(valor -s); then nivel=servidor
elif v=$(valor -p -t "$target"); then nivel=panel
elif v=$(valor -w -t "$target"); then nivel=ventana
elif v=$(valor -t "$target"); then nivel=sesión
elif v=$(valor -gw) || v=$(valor -g); then nivel=global
else
  echo "kit-opcion: la opción $opcion no existe o no tiene valor" >&2
  exit 1
fi

echo "$v ($nivel)"
