#!/usr/bin/env bash
# kit-layout — ventana de trabajo de tres paneles, y guardar/cargar layouts.
#
# Uso: kit-layout new SESION [DIR]       crea la ventana "trabajo" (editor, shell, logs)
#      kit-layout save VENTANA ARCHIVO   guarda el layout de una ventana
#      kit-layout load VENTANA ARCHIVO   aplica un layout guardado
#
# Salida: 0 bien, 1 error de tmux o de estado, 2 uso incorrecto.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

usage() { sed -n '4,6p' "$0" | sed 's/^# //' >&2; exit 2; }
die() { echo "kit-layout: $*" >&2; exit 1; }

# TODO 1: count_panes LAYOUT — imprime cuántos paneles describe un layout.
#         Cada panel aparece como ANCHOxALTO,X,Y,ID (cuatro números tras el
#         tamaño); los contenedores llevan solo X,Y y después { o [. Pista:
#         grep -oE '[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+' <<<"$1" | wc -l

# TODO 2: require_window VENTANA — sale con error si la ventana no existe.
#         display-message no falla con un target inexistente; list-panes sí:
#         tmx list-panes -t "$1" >/dev/null 2>&1 || die "no existe la ventana: $1"

cmd_new() {
  local session="$1" dir="${2:-$PWD}"
  # TODO 3: declara local editor shell logs. Si "$dir" no es un directorio,
  #         die. Si la sesión existe (tmx has-session -t "=$session" 2>/dev/null):
  #           - si ya tiene una ventana trabajo, die. Pista:
  #             tmx list-windows -t "=$session" -F '#{window_name}' | grep -qx trabajo
  #           - si no, editor=$(tmx new-window -d -P -F '#{pane_id}' -t "=$session:" -n trabajo -c "$dir")
  #         Si no existe:
  #           editor=$(tmx new-session -d -P -F '#{pane_id}' -s "$session" -n trabajo -c "$dir")
  # TODO 4: parte en tres con ids, -d y -c "$dir":
  #         shell=$(tmx split-window -d -h -P -F '#{pane_id}' -t "$editor" -c "$dir")
  #         logs=... (lo mismo con -v y -t "$shell")
  # TODO 5: títulos editor, shell y logs: tmx select-pane -t "$editor" -T editor ...
  # TODO 6: tmx set-option -w -t "$editor" main-pane-width 60%, después
  #         tmx select-layout -t "$editor" main-vertical, deja activo el editor
  #         (tmx select-pane -t "$editor") y avisa:
  #         echo "ventana trabajo lista en la sesión $session"
  echo "kit-layout new: sin implementar ($session $dir)" >&2; exit 99
}

cmd_save() {
  local window="$1" file="$2"
  # TODO 7: local layout; require_window "$window";
  #         layout=$(tmx display-message -p -t "$window" '#{window_layout}');
  #         escríbelo con printf '%s\n' "$layout" >"$file" y avisa:
  #         echo "layout de $window guardado en $file ($(count_panes "$layout") paneles)"
  echo "kit-layout save: sin implementar ($window $file)" >&2; exit 99
}

cmd_load() {
  local window="$1" file="$2"
  # TODO 8: local layout expected actual. En este orden, y con die en
  #         cuanto algo falle:
  #         - el archivo se puede leer: [[ -r "$file" ]]; layout=$(<"$file")
  #         - tiene un layout de tmux: [[ "$layout" =~ ^[0-9a-f]{4},[0-9]+x[0-9]+, ]]
  #         - require_window "$window"
  #         - expected=$(count_panes "$layout") es igual a
  #           actual=$(tmx display-message -p -t "$window" '#{window_panes}')
  #         Después tmx select-layout -t "$window" "$layout" y avisa:
  #         echo "layout de $file aplicado a $window"
  echo "kit-layout load: sin implementar ($window $file)" >&2; exit 99
}

case "${1:-}" in
  new)  shift; (( $# == 1 || $# == 2 )) || usage; cmd_new "$@" ;;
  save) shift; (( $# == 2 )) || usage; cmd_save "$@" ;;
  load) shift; (( $# == 2 )) || usage; cmd_load "$@" ;;
  *)    usage ;;
esac
