#!/usr/bin/env bash
# dev-down — cierra la sesión de un proyecto, y solo esa.
#
# Uso: dev-down NAME
#      TMUX_SOCKET=kit dev-down api     en el servidor de tmux -L kit
# Salida: 0 cerrada, 1 no existe esa sesión (o no hay servidor), 2 uso incorrecto.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

usage() {
  sed -n '4,6s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

[[ $# -eq 1 && -n "${1:-}" ]] || usage
name=$1

# TODO 6: si tmx has-session -t "=$name" falla, "dev-down: no existe la
# sesión '$name'" por stderr y exit 1; si no, tmx kill-session -t "=$name" y
# "dev-down: sesión '$name' cerrada". Sin "=", "-t api" cierra api-2 cuando
# api no existe (lab-06-script-roto). Después borra las dos líneas siguientes.
echo "dev-down: sin implementar ($name)" >&2
exit 1
