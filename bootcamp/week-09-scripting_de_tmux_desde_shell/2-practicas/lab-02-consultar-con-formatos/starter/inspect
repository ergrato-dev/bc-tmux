  #     echo "$session"
  #     ...TODO 2...
  #   done
  # TODO 2: dentro del bucle, las ventanas de esa sesión exacta ("=") con
  # sangría de dos espacios:
  #   tmx list-windows -t "=$session" -F '  #{window_index} #{window_name} paneles: #{window_panes}'
  # Borra el echo de abajo al terminar.
  echo "sin implementar" >&2
}

show_pane() {
  local target=$1
  # TODO 3: valida el target con list-panes (falla si no existe; display -p
  # no) y, si falla, escribe en stderr "inspect: no existe el target '...'"
  # y sal con 1:
  #   tmx list-panes -t "$target" -F '#{pane_id}' >/dev/null 2>&1 || { ...; exit 1; }
  # TODO 4: imprime el panel con
  #   tmx display -p -t "$target" '#{pane_id} #{pane_current_command} #{pane_current_path}'
  # Borra el echo de abajo al terminar.
  echo "sin implementar: $target" >&2
}

case "${1:-}" in
  tree) (( $# == 1 )) || usage; show_tree ;;
  pane) (( $# == 2 )) || usage; show_pane "$2" ;;
  *)    usage ;;
esac
