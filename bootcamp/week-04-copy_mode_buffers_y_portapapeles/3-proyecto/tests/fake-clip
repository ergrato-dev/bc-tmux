#!/usr/bin/env bash
# fake-clip — para el autograding. Se enlaza con el nombre de una herramienta
# de portapapeles (wl-copy, xclip, xsel, pbcopy, clip.exe, win32yank.exe) y
# guarda lo que recibe junto a sí: NOMBRE.data (stdin) y NOMBRE.args.
set -euo pipefail
dir=$(dirname "$0")
name=$(basename "$0")
printf '%s\n' "$*" >"$dir/$name.args"
cat >"$dir/$name.data"
