#!/usr/bin/env bash
# path-falso — para el autograding. Crea un directorio temporal que sirve de
# PATH único: enlaza todos los ejecutables de tu PATH salvo las herramientas
# de portapapeles reales, y añade las falsas que pidas. Imprime el directorio.
# Uso: path-falso [wl-copy|xclip|xsel|pbcopy|clip.exe|win32yank.exe|darwin]...
#      "darwin" hace que uname responda Darwin (macOS); sin él responde Linux,
#      también en un Mac, para que las pruebas no dependan de tu sistema.
set -euo pipefail

reales='^(wl-copy|xclip|xsel|pbcopy|clip\.exe|win32yank\.exe)$'
dir=$(mktemp -d)
aqui=$(cd "$(dirname "$0")" && pwd)

IFS=: read -ra rutas <<<"$PATH"
for ruta in "${rutas[@]}"; do
  [[ -d "$ruta" ]] || continue
  for exe in "$ruta"/*; do
    nombre=$(basename "$exe")
    [[ -x "$exe" && ! -e "$dir/$nombre" ]] || continue
    [[ "$nombre" =~ $reales ]] && continue
    ln -s "$exe" "$dir/$nombre"
  done
done

sistema=Linux
for falsa in "$@"; do
  if [[ "$falsa" == darwin ]]; then
    sistema=Darwin
  else
    ln -s "$aqui/falso-clip" "$dir/$falsa"
  fi
done
rm -f "$dir/uname"
printf '#!/bin/sh\necho %s\n' "$sistema" >"$dir/uname"
chmod +x "$dir/uname"
echo "$dir"
