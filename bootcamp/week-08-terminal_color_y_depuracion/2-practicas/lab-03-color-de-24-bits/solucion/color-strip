#!/usr/bin/env bash
# color-strip — franja de degradado (rojo → verde → azul) en color de 24 bits.
# Con 24 bits se ve continua; aproximada a 256 colores se ve a bandas.
# Uso: color-strip [ANCHO]   (por defecto 64 columnas, mínimo 2)
set -euo pipefail

width="${1:-64}"
if ! [[ "$width" =~ ^[0-9]+$ ]] || ((width < 2)); then
  echo "uso: color-strip [ANCHO>=2]" >&2
  exit 2
fi

for ((i = 0; i < width; i++)); do
  r=$((255 - i * 255 / (width - 1)))
  g=$((i * 510 / (width - 1)))
  if ((g > 255)); then g=$((510 - g)); fi
  b=$((i * 255 / (width - 1)))
  printf '\e[48;2;%d;%d;%dm ' "$r" "$g" "$b"
done
# Sin el reset, el fondo del último color se queda pintado en el prompt.
printf '\e[0m\n'
