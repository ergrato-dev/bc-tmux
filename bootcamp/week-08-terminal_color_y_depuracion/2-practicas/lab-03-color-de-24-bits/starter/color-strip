#!/usr/bin/env bash
# color-strip — franja de degradado (rojo → verde → azul) en color de 24 bits.
# Con 24 bits se ve continua; aproximada a 256 colores se ve a bandas.
# Uso: color-strip [ANCHO]   (por defecto 64 columnas, mínimo 2)
set -euo pipefail

width="${1:-64}"
if ! [[ "$width" =~ ^[0-9]+$ ]] || ((width < 2)); then
  echo "uso: color-strip [ANCHO>=2]" >&2
  exit 2
fi

