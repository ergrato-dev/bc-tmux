# con 0, fallo si no) y línea "terminfo": ok si infocmp tmux-256color
# funciona, fallo si no, aviso si no está infocmp (lab-02-terminfo).

# --- Servidor ----------------------------------------------------------------

# TODO 6: si tmx list-sessions falla, línea "aviso  servidor" y exit "$failed"
# (list-sessions no arranca un servidor; show-options sí). Si hay servidor:
# líneas "servidor" (#{socket_path}), "default-terminal" (fallo si es
# xterm*), "escape-time" (fallo si pasa de 50) y "extended-keys" (aviso si
# es off). Con tmx show -sv (lab-06-depurar-una-terminal-rota).

# --- Cliente: la terminal de fuera -------------------------------------------

# TODO 7: el cliente más reciente con tmx list-clients -F y #{client_activity},
# #{client_name}, #{client_termname} y #{client_termfeatures}. Sin cliente,
# "aviso  cliente". Con cliente: "cliente", "term-fuera" (aviso si es tmux* o
# screen*) y "color" (aviso si RGB no está en las features).

# TODO 8: borra las dos líneas siguientes y termina con exit "$failed".
echo "kit-doctor: sin implementar" >&2
exit 1
