#!/usr/bin/env bash
# kit-layout — ventana de trabajo de tres paneles, y guardar/cargar layouts.
#
# Uso: kit-layout new SESION [DIR]       crea la ventana "trabajo" (editor, shell, logs)
#      kit-layout save VENTANA ARCHIVO   guarda el layout de una ventana
#      kit-layout load VENTANA ARCHIVO   aplica un layout guardado
#
# Salida: 0 bien, 1 error de tmux o de estado, 2 uso incorrecto.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

usage() { sed -n '4,6p' "$0" | sed 's/^# //' >&2; exit 2; }
die() { echo "kit-layout: $*" >&2; exit 1; }

# Un layout guardado describe cada panel como ANCHOxALTO,X,Y,ID; los
# contenedores ({...} o [...]) no llevan ID. Contar esas hojas da los paneles.
count_panes() {
  grep -oE '[0-9]+x[0-9]+,[0-9]+,[0-9]+,[0-9]+' <<<"$1" | wc -l
}

# display-message no falla con un target inexistente: cae en otra ventana y
# sale con 0. list-panes sí falla, así que se usa para validar.
require_window() {
  tmx list-panes -t "$1" >/dev/null 2>&1 || die "no existe la ventana: $1"
}

cmd_new() {
  local session="$1" dir="${2:-$PWD}" editor shell logs
  [[ -d "$dir" ]] || die "no existe el directorio: $dir"

  # "=" pide el nombre exacto: sin él, "api" encontraría también "api2".
  if tmx has-session -t "=$session" 2>/dev/null; then
    if tmx list-windows -t "=$session" -F '#{window_name}' | grep -qx trabajo; then
      die "la sesión $session ya tiene una ventana trabajo"
    fi
    editor=$(tmx new-window -d -P -F '#{pane_id}' -t "=$session:" -n trabajo -c "$dir")
  else
    editor=$(tmx new-session -d -P -F '#{pane_id}' -s "$session" -n trabajo -c "$dir")
  fi

  # Se trabaja con los ids que devuelve -P: los índices se renumeran al partir.
  shell=$(tmx split-window -d -h -P -F '#{pane_id}' -t "$editor" -c "$dir")
  logs=$(tmx split-window -d -v -P -F '#{pane_id}' -t "$shell" -c "$dir")

  tmx select-pane -t "$editor" -T editor
  tmx select-pane -t "$shell" -T shell
  tmx select-pane -t "$logs" -T logs

  # main-vertical deja el primer panel (editor) a la izquierda y apila el resto
  # a la derecha. El ancho en porcentaje se adapta al tamaño de cada cliente.
  tmx set-option -w -t "$editor" main-pane-width 60%
  tmx select-layout -t "$editor" main-vertical
  tmx select-pane -t "$editor"

  echo "ventana trabajo lista en la sesión $session"
}

cmd_save() {
  local window="$1" file="$2" layout
  require_window "$window"
  layout=$(tmx display-message -p -t "$window" '#{window_layout}')
  printf '%s\n' "$layout" >"$file"
  echo "layout de $window guardado en $file ($(count_panes "$layout") paneles)"
}

cmd_load() {
  local window="$1" file="$2" layout expected actual
  [[ -r "$file" ]] || die "no puedo leer el archivo: $file"
  layout=$(<"$file")
  [[ "$layout" =~ ^[0-9a-f]{4},[0-9]+x[0-9]+, ]] || die "$file no contiene un layout de tmux"

  require_window "$window"
  actual=$(tmx display-message -p -t "$window" '#{window_panes}')
  expected=$(count_panes "$layout")

  # tmux 3.4 no siempre se queja si el número de paneles no coincide: lo
  # comprobamos nosotros para no dejar la ventana en un estado a medias.
  if (( expected != actual )); then
    die "el layout es para $expected paneles y $window tiene $actual"
  fi
  tmx select-layout -t "$window" "$layout"
  echo "layout de $file aplicado a $window"
}

case "${1:-}" in
  new)  shift; (( $# == 1 || $# == 2 )) || usage; cmd_new "$@" ;;
  save) shift; (( $# == 2 )) || usage; cmd_save "$@" ;;
  load) shift; (( $# == 2 )) || usage; cmd_load "$@" ;;
  *)    usage ;;
esac
