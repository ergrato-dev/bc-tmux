group() {
  # TODO 6: crea la nueva en el grupo de la base; falla si no se puede (paso 6).

  # Borra estas dos líneas al empezar:
  echo "kit-sessions group: sin implementar ($*)" >&2
  exit 99
}

case "${1:-list}:$#" in
  list:0 | list:1) list_sessions ;;
  jump:2)          jump "$2" ;;
  new:2)           new_session "$2" ;;
  new:3)           new_session "$2" "$3" ;;
  group:3)         group "$2" "$3" ;;
  *)               usage ;;
esac
