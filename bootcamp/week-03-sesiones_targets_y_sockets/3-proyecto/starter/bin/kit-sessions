#!/usr/bin/env bash
# kit-sessions — lista las sesiones de tmux y salta entre ellas.
#
# Uso: kit-sessions [list]                lista, la usada más recientemente primero
#      kit-sessions jump NOMBRE           salta a la sesión (attach o switch-client)
#      kit-sessions new NOMBRE [DIR]      la crea si no existe y salta a ella
#      kit-sessions group BASE NUEVA      crea NUEVA en el grupo de BASE
# Salida: 0 bien, 1 la sesión no existe o no hay servidor, 2 uso incorrecto.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

usage() {
  sed -n '4,8s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

die() { echo "kit-sessions: $*" >&2; exit 1; }

# "=" pide coincidencia exacta: sin él, "-t api" también encuentra "api-2".
exists() { tmx has-session -t "=$1" 2>/dev/null; }

names() { tmx list-sessions -F '#{session_name}' 2>/dev/null | paste -sd' ' -; }

