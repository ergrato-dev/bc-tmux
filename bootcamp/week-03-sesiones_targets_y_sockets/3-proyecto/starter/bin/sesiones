  # Borra estas dos líneas al empezar:
  echo "sesiones grupo: sin implementar ($*)" >&2
  exit 99
}

case "${1:-ls}:$#" in
  ls:0 | ls:1) listar ;;
  ir:2)        ir "$2" ;;
  nueva:2)     nueva "$2" ;;
  nueva:3)     nueva "$2" "$3" ;;
  grupo:3)     grupo "$2" "$3" ;;
  *)           uso ;;
esac
