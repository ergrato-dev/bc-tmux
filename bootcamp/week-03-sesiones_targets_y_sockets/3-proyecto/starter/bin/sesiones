#!/usr/bin/env bash
# sesiones — lista las sesiones de tmux y salta entre ellas.
#
# Uso: sesiones [ls]                 lista, la usada más recientemente primero
#      sesiones ir NOMBRE            salta a la sesión (attach o switch-client)
#      sesiones nueva NOMBRE [DIR]   la crea si no existe y salta a ella
#      sesiones grupo BASE NUEVA     crea NUEVA en el grupo de BASE
# Salida: 0 bien, 1 la sesión no existe o no hay servidor, 2 uso incorrecto.
set -euo pipefail

tmx() { "${TMUX_BIN:-tmux}" ${TMUX_SOCKET:+-L "$TMUX_SOCKET"} "$@"; }

uso() {
  sed -n '4,8s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

error() { echo "sesiones: $*" >&2; exit 1; }

# "=" pide coincidencia exacta: sin él, "-t api" también encuentra "api-2".
existe() { tmx has-session -t "=$1" 2>/dev/null; }

nombres() { tmx list-sessions -F '#{session_name}' 2>/dev/null | paste -sd' ' -; }

